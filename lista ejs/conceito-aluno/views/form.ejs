
<h1>Avaliação do Aluno</h1>
<form action="/" method="POST">
  <label>Nota 1: <input type="number" step="0.01" name="nota1" required></label><br>
  <label>Nota 2: <input type="number" step="0.01" name="nota2" required></label><br>
  <button type="submit">Calcular Média</button>
</form>
<% if (resultado) { %>
  <p><strong>Nota 1:</strong> <%= resultado.nota1 %></p>
  <p><strong>Nota 2:</strong> <%= resultado.nota2 %></p>
  <p><strong>Média:</strong> <%= resultado.media %></p>
  <p><strong>Conceito:</strong> <%= resultado.conceito %></p>
<% } %>
