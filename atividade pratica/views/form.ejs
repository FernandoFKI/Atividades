
<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Verificar Triângulo</title>
</head>
<body>
  <h1>Verificador de Triângulo</h1>
  <form action="/verificar" method="POST">
    <label>Lado 1: <input type="number" step="any" name="lado1" required></label><br>
    <label>Lado 2: <input type="number" step="any" name="lado2" required></label><br>
    <label>Lado 3: <input type="number" step="any" name="lado3" required></label><br>
    <button type="submit">Verificar</button>
  </form>

  <% if (resultado) { %>
    <h2><%= resultado %></h2>
  <% } %>
</body>
</html>
